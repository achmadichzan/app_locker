import { CheckBox, ScrollView, LineEdit } from "std-widgets.slint";

export struct AppItem {
    name: string,
    locked: bool,
}

export component ManagementPanel inherits Window {
    in-out property <[AppItem]> apps: [];
    in-out property <string> new-app-name: "";
    in-out property <string> status-msg: "";
    in-out property <[string]> running-apps: [];
    in-out property <bool> show-running-apps: false;
    in-out property <bool> show-change-password: false;
    in-out property <string> old-password: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in-out property <string> password-status-msg: "";

    callback toggle-app(int);
    callback add-app(string);
    callback remove-app(int);
    callback save-config();
    callback browse-file();
    callback fetch-running-apps();
    callback select-running-app(string);
    callback change-password(string, string, string);

    title: "App Locker";
    width: 480px;
    height: 520px;
    background: #1a1a2e;

    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "🔒";
                    font-size: 26px;
                    vertical-alignment: center;
                }
                Text {
                    text: "App Locker";
                    font-size: 26px;
                    font-weight: 800;
                    color: #e8e8f0;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "Pilih aplikasi yang ingin dikunci";
                font-size: 13px;
                color: #8888aa;
                horizontal-alignment: center;
            }

            Rectangle {
                background: #16213e;
                border-radius: 12px;
                border-color: #0f3460;
                border-width: 1px;
                vertical-stretch: 1;

                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;

                        for item[index] in root.apps: Rectangle {
                            height: 48px;
                            background: item-ta.has-hover ? #1a2744 : transparent;
                            border-radius: 8px;

                            item-ta := TouchArea {}

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 12px;

                                CheckBox {
                                    checked: item.locked;
                                    toggled => { root.toggle-app(index); }
                                }

                                Text {
                                    text: item.name;
                                    font-size: 14px;
                                    color: item.locked ? #e8e8f0 : #6a6a8a;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: del-ta.has-hover ? #3d1a1a : transparent;

                                    del-ta := TouchArea {
                                        clicked => { root.remove-app(index); }
                                    }

                                    Text {
                                        text: "✕";
                                        font-size: 14px;
                                        color: del-ta.has-hover ? #ff6b6b : #555577;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                height: 44px;

                app-input := LineEdit {
                    placeholder-text: "Contoh: chrome.exe";
                    text <=> root.new-app-name;
                    font-size: 13px;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 48px;
                    height: 44px;
                    border-radius: 8px;
                    background: browse-ta.has-hover ? #2a2a44 : #252540;
                    border-color: #3a3a55;
                    border-width: 1px;

                    browse-ta := TouchArea {
                        clicked => { root.browse-file(); }
                    }

                    Text {
                        text: "📁";
                        font-size: 16px;
                        width: 24px;
                        height: 28px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Rectangle {
                    width: 48px;
                    height: 44px;
                    border-radius: 8px;
                    background: run-ta.has-hover ? #2a2a44 : #252540;
                    border-color: #3a3a55;
                    border-width: 1px;

                    run-ta := TouchArea {
                        clicked => { root.fetch-running-apps(); }
                    }

                    Text {
                        text: "⚙";
                        font-size: 16px;
                        width: 24px;
                        height: 28px;
                        vertical-alignment: center;
                        color: root.show-running-apps ? #16a34a : #e8e8f0;
                        horizontal-alignment: center;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Rectangle {
                    width: 96px;
                    height: 44px;
                    border-radius: 8px;
                    background: add-ta.has-hover ? #1a6b3a : #16a34a;

                    add-ta := TouchArea {
                        clicked => {
                            if root.new-app-name != "" {
                                root.add-app(root.new-app-name);
                                root.new-app-name = "";
                            }
                        }
                    }

                    Text {
                        text: "+ Tambah";
                        font-size: 13px;
                        font-weight: 600;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            
            if root.show-running-apps: Rectangle {
                background: #16213e;
                border-radius: 8px;
                border-color: #0f3460;
                border-width: 1px;
                height: 180px;

                VerticalLayout {
                    padding: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-bottom: 4px;
                        Text {
                            text: "Aplikasi Berjalan:";
                            font-size: 12px;
                            color: #8888aa;
                        }
                        TouchArea {
                            width: 16px;
                            height: 16px;
                            clicked => { root.show-running-apps = false; }
                            Text {
                                text: "✕";
                                font-size: 12px;
                                color: #ff6b6b;
                            }
                        }
                    }
                    
                    ScrollView {
                        VerticalLayout {
                            spacing: 2px;
                            for app-name in root.running-apps: Rectangle {
                                height: 28px;
                                background: app-ta.has-hover ? #2a4a8a : transparent;
                                border-radius: 4px;

                                app-ta := TouchArea {
                                    clicked => { 
                                        root.select-running-app(app-name);
                                        root.show-running-apps = false;
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    Text {
                                        text: app-name;
                                        font-size: 13px;
                                        color: #e8e8f0;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 44px;
                border-radius: 10px;
                background: save-ta.has-hover ? #2952a3 : #3b82f6;

                save-ta := TouchArea {
                    clicked => { root.save-config(); }
                }

                Text {
                    text: "💾  Simpan Konfigurasi";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.status-msg;
                font-size: 12px;
                color: #16a34a;
                horizontal-alignment: center;
            }

            Rectangle {
                height: 44px;
                border-radius: 10px;
                background: pw-toggle-ta.has-hover ? #3a2a5a : #4a3a6a;

                pw-toggle-ta := TouchArea {
                    clicked => {
                        root.show-change-password = !root.show-change-password;
                        root.password-status-msg = "";
                        root.old-password = "";
                        root.new-password = "";
                        root.confirm-password = "";
                    }
                }

                Text {
                    text: root.show-change-password ? "🔑  Tutup Ubah Password" : "🔑  Ubah Password";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.show-change-password: Rectangle {
                background: #16213e;
                border-radius: 12px;
                border-color: #0f3460;
                border-width: 1px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        text: "Password Lama";
                        font-size: 12px;
                        color: #8888aa;
                    }
                    old-pw-input := LineEdit {
                        placeholder-text: "Masukkan password lama...";
                        input-type: password;
                        font-size: 13px;
                        text <=> root.old-password;
                    }

                    Text {
                        text: "Password Baru";
                        font-size: 12px;
                        color: #8888aa;
                    }
                    new-pw-input := LineEdit {
                        placeholder-text: "Masukkan password baru...";
                        input-type: password;
                        font-size: 13px;
                        text <=> root.new-password;
                    }

                    Text {
                        text: "Konfirmasi Password Baru";
                        font-size: 12px;
                        color: #8888aa;
                    }
                    confirm-pw-input := LineEdit {
                        placeholder-text: "Konfirmasi password baru...";
                        input-type: password;
                        font-size: 13px;
                        text <=> root.confirm-password;
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: change-pw-ta.has-hover ? #1a6b3a : #16a34a;

                        change-pw-ta := TouchArea {
                            clicked => {
                                root.change-password(root.old-password, root.new-password, root.confirm-password);
                            }
                        }

                        Text {
                            text: "✅  Simpan Password Baru";
                            font-size: 14px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.password-status-msg;
                        font-size: 12px;
                        color: root.password-status-msg == "✅ Password berhasil diubah!" ? #16a34a : #ff6b6b;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

export component AppPrompt inherits Window {
    in property <string> target_name: "Aplikasi";
    in-out property <string> error_msg: "";

    callback unlock-requested(string);
    callback cancel-requested();

    title: "App Locker";
    width: 380px;
    height: 260px;
    always-on-top: true;
    no-frame: false;
    background: #1a1a2e;

    VerticalLayout {
        padding: 28px;
        spacing: 14px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: "🔒";
                font-size: 28px;
                vertical-alignment: center;
            }
            Text {
                text: "Akses Terkunci";
                font-size: 22px;
                font-weight: 800;
                color: #e8e8f0;
                vertical-alignment: center;
            }
        }

        Text {
            text: target_name + " sedang dibekukan oleh sistem.";
            font-size: 13px;
            horizontal-alignment: center;
            color: #8888aa;
        }

        input := LineEdit {
            placeholder-text: "Masukkan Password...";
            input-type: password;
            font-size: 14px;
        }

        Text {
            text: root.error_msg;
            color: #ff6b6b;
            font-size: 12px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 110px;
                height: 40px;
                border-radius: 8px;
                background: cancel-ta.has-hover ? #2a2a44 : #252540;
                border-color: #3a3a55;
                border-width: 1px;

                cancel-ta := TouchArea {
                    clicked => { root.cancel-requested(); }
                }

                Text {
                    text: "Batal";
                    font-size: 14px;
                    font-weight: 600;
                    color: #aaaacc;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 140px;
                height: 40px;
                border-radius: 8px;
                background: unlock-ta.has-hover ? #2952a3 : #3b82f6;

                unlock-ta := TouchArea {
                    clicked => { root.unlock-requested(input.text); }
                }

                Text {
                    text: "🔓 Buka Kunci";
                    font-size: 14px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
