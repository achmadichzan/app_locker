import { CheckBox, ScrollView, LineEdit } from "std-widgets.slint";

export struct AppItem {
    name: string,
    locked: bool,
}

export component ManagementPanel inherits Window {
    in-out property <[AppItem]> apps: [];
    in-out property <string> new-app-name: "";
    in-out property <string> status-msg: "";
    in-out property <bool> show-change-password: false;
    in-out property <string> old-password: "";
    in-out property <string> new-password: "";
    in-out property <string> confirm-password: "";
    in-out property <string> password-status-msg: "";
    in-out property <bool> protection-active: false;
    in-out property <string> protection-status-msg: "";
    in-out property <bool> service-installed: false;

    callback toggle-app(int);
    callback add-app(string);
    callback remove-app(int);
    callback save-config();
    callback browse-file();
    callback change-password(string, string, string);
    callback toggle-protection();
    callback check-protection-status();
    callback install-service();
    callback uninstall-service();

    title: "App Locker";
    width: 480px;
    height: 560px;
    background: #1a1a2e;

    ScrollView {
        VerticalLayout {
            padding: 28px;
            spacing: 12px;

            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "🔒";
                    font-size: 26px;
                    vertical-alignment: center;
                }
                Text {
                    text: "App Locker";
                    font-size: 26px;
                    font-weight: 800;
                    color: #e8e8f0;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "Tambah aplikasi yang ingin dikunci";
                font-size: 13px;
                color: #8888aa;
                horizontal-alignment: center;
            }

            Rectangle {
                background: #16213e;
                border-radius: 12px;
                border-color: #0f3460;
                border-width: 1px;
                vertical-stretch: 1;

                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;

                        for item[index] in root.apps: Rectangle {
                            height: 48px;
                            background: item-ta.has-hover ? #1a2744 : transparent;
                            border-radius: 8px;

                            item-ta := TouchArea {}

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 12px;
                                spacing: 12px;

                                CheckBox {
                                    checked: item.locked;
                                    toggled => { root.toggle-app(index); }
                                }

                                Text {
                                    text: item.name;
                                    font-size: 14px;
                                    color: item.locked ? #e8e8f0 : #6a6a8a;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 6px;
                                    background: del-ta.has-hover ? #3d1a1a : transparent;

                                    del-ta := TouchArea {
                                        clicked => { root.remove-app(index); }
                                    }

                                    Text {
                                        text: "✕";
                                        font-size: 14px;
                                        color: del-ta.has-hover ? #ff6b6b : #555577;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 12px;
                height: 44px;

                app-input := LineEdit {
                    placeholder-text: "Contoh: chrome.exe";
                    text <=> root.new-app-name;
                    font-size: 13px;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 48px;
                    height: 44px;
                    border-radius: 8px;
                    background: browse-ta.has-hover ? #2a2a44 : #252540;
                    border-color: #3a3a55;
                    border-width: 1px;

                    browse-ta := TouchArea {
                        clicked => { root.browse-file(); }
                    }

                    Text {
                        text: "📁";
                        font-size: 16px;
                        width: 24px;
                        height: 28px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                Rectangle {
                    width: 96px;
                    height: 44px;
                    border-radius: 8px;
                    background: add-ta.has-hover ? #1a6b3a : #16a34a;

                    add-ta := TouchArea {
                        clicked => {
                            if root.new-app-name != "" {
                                root.add-app(root.new-app-name);
                                root.new-app-name = "";
                            }
                        }
                    }

                    Text {
                        text: "+ Tambah";
                        font-size: 13px;
                        font-weight: 600;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 44px;
                border-radius: 10px;
                background: save-ta.has-hover ? #2952a3 : #3b82f6;

                save-ta := TouchArea {
                    clicked => { root.save-config(); }
                }

                Text {
                    text: "💾  Simpan Konfigurasi";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.status-msg;
                font-size: 12px;
                color: #16a34a;
                horizontal-alignment: center;
            }

            if !root.service-installed: Rectangle {
                height: 44px;
                border-radius: 10px;
                background: install-ta.has-hover ? #1a6b3a : #16a34a;

                install-ta := TouchArea {
                    clicked => { root.install-service(); }
                }

                Text {
                    text: "⬇️  Install Service";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.service-installed: Rectangle {
                height: 52px;
                border-radius: 10px;
                background: #16213e;
                border-color: root.protection-active ? #16a34a : #0f3460;
                border-width: root.protection-active ? 2px : 1px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;

                    Text {
                        text: root.protection-active ? "🛡️  Proteksi Aktif" : "🛡️  Proteksi Nonaktif";
                        font-size: 14px;
                        font-weight: 600;
                        color: root.protection-active ? #16a34a : #ff6b6b;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    Rectangle {
                        width: 48px;
                        height: 26px;
                        border-radius: 13px;
                        background: root.protection-active ? #16a34a : #3a3a55;
                        y: (parent.height - self.height) / 2;

                        animate background { duration: 200ms; easing: ease-in-out; }

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: white;
                            y: 3px;
                            x: root.protection-active ? parent.width - self.width - 3px : 3px;

                            animate x { duration: 200ms; easing: ease-in-out; }
                        }

                        prot-ta := TouchArea {
                            clicked => { root.toggle-protection(); }
                        }
                    }
                }
            }

            if root.service-installed: Rectangle {
                height: 44px;
                border-radius: 10px;
                background: uninstall-ta.has-hover ? #5a1a1a : #8b2525;

                uninstall-ta := TouchArea {
                    clicked => { root.uninstall-service(); }
                }

                Text {
                    text: "🗑️  Uninstall Service";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.protection-status-msg != "": Text {
                text: root.protection-status-msg;
                font-size: 12px;
                color: root.protection-status-msg == "✅ Service dimulai!" || root.protection-status-msg == "✅ Service dihentikan." || root.protection-status-msg == "✅ Service berhasil diinstall!" || root.protection-status-msg == "✅ Service berhasil di-uninstall." ? #16a34a : #ff6b6b;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Rectangle {
                height: 44px;
                border-radius: 10px;
                background: pw-toggle-ta.has-hover ? #3a2a5a : #4a3a6a;

                pw-toggle-ta := TouchArea {
                    clicked => {
                        root.show-change-password = !root.show-change-password;
                        root.password-status-msg = "";
                        root.old-password = "";
                        root.new-password = "";
                        root.confirm-password = "";
                    }
                }

                Text {
                    text: root.show-change-password ? "🔑  Tutup Ubah Password" : "🔑  Ubah Password";
                    font-size: 15px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.show-change-password: Rectangle {
                background: #16213e;
                border-radius: 12px;
                border-color: #0f3460;
                border-width: 1px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        text: "Password Lama";
                        font-size: 12px;
                        color: #8888aa;
                    }
                    old-pw-input := LineEdit {
                        placeholder-text: "Masukkan password lama...";
                        input-type: password;
                        font-size: 13px;
                        text <=> root.old-password;
                    }

                    Text {
                        text: "Password Baru";
                        font-size: 12px;
                        color: #8888aa;
                    }
                    new-pw-input := LineEdit {
                        placeholder-text: "Masukkan password baru...";
                        input-type: password;
                        font-size: 13px;
                        text <=> root.new-password;
                    }

                    Text {
                        text: "Konfirmasi Password Baru";
                        font-size: 12px;
                        color: #8888aa;
                    }
                    confirm-pw-input := LineEdit {
                        placeholder-text: "Konfirmasi password baru...";
                        input-type: password;
                        font-size: 13px;
                        text <=> root.confirm-password;
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 8px;
                        background: change-pw-ta.has-hover ? #1a6b3a : #16a34a;

                        change-pw-ta := TouchArea {
                            clicked => {
                                root.change-password(root.old-password, root.new-password, root.confirm-password);
                            }
                        }

                        Text {
                            text: "✅  Simpan Password Baru";
                            font-size: 14px;
                            font-weight: 700;
                            color: white;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.password-status-msg;
                        font-size: 12px;
                        color: root.password-status-msg == "✅ Password berhasil diubah!" ? #16a34a : #ff6b6b;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
}

export component AppPrompt inherits Window {
    in property <string> target_name: "Aplikasi";
    in-out property <string> error_msg: "";
    in-out property <bool> is-loading: false;

    callback unlock-requested(string);
    callback cancel-requested();

    title: "App Locker";
    width: 380px;
    height: 260px;
    always-on-top: true;
    no-frame: false;
    background: #1a1a2e;

    init => { input.focus(); }

    FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.cancel-requested();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            padding: 28px;
            spacing: 14px;
            alignment: center;

            HorizontalLayout {
                alignment: center;
                spacing: 10px;

                Text {
                    text: "🔒";
                    font-size: 28px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Akses Terkunci";
                    font-size: 22px;
                    font-weight: 800;
                    color: #e8e8f0;
                    vertical-alignment: center;
                }
            }

            Text {
                text: target_name + " membutuhkan password untuk dibuka.";
                font-size: 13px;
                horizontal-alignment: center;
                color: #8888aa;
            }

            input := LineEdit {
                placeholder-text: "Masukkan Password...";
                input-type: password;
                font-size: 14px;
                enabled: !root.is-loading;
                accepted => {
                    if (!root.is-loading && self.text != "") {
                        root.is-loading = true;
                        root.error-msg = "";
                        root.unlock-requested(self.text);
                    }
                }
            }

            Text {
                text: root.error_msg;
                color: #ff6b6b;
                font-size: 12px;
                horizontal-alignment: center;
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Rectangle {
                    width: 110px;
                    height: 40px;
                    border-radius: 8px;
                    background: cancel-ta.has-hover ? #2a2a44 : #252540;
                    border-color: #3a3a55;
                    border-width: 1px;

                    cancel-ta := TouchArea {
                        enabled: !root.is-loading;
                        clicked => { root.cancel-requested(); }
                    }

                    Text {
                        text: "Batal";
                        font-size: 14px;
                        font-weight: 600;
                        color: #aaaacc;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 140px;
                    height: 40px;
                    border-radius: 8px;
                    background: root.is-loading ? #1e3a8a : (unlock-ta.has-hover ? #2952a3 : #3b82f6);

                    unlock-ta := TouchArea {
                        enabled: !root.is-loading;
                        clicked => {
                            if (!root.is-loading && input.text != "") {
                                root.is-loading = true;
                                root.error-msg = "";
                                root.unlock-requested(input.text);
                            }
                        }
                    }

                    Text {
                        text: root.is-loading ? "Memverifikasi..." : "🔓 Buka Kunci";
                        font-size: 14px;
                        font-weight: 700;
                        color: white;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
