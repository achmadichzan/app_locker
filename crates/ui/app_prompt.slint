import { LineEdit } from "std-widgets.slint";

export component AppPrompt inherits Window {
    in property <string> target_name: "Aplikasi";
    in-out property <string> error_msg: "";

    callback unlock-requested(string);
    callback cancel-requested();

    title: "App Locker";
    width: 380px;
    height: 260px;
    always-on-top: true;
    no-frame: false;
    background: #1a1a2e;

    VerticalLayout {
        padding: 28px;
        spacing: 14px;
        alignment: center;

        HorizontalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: "🔒";
                font-size: 28px;
                vertical-alignment: center;
            }
            Text {
                text: "Akses Terkunci";
                font-size: 22px;
                font-weight: 800;
                color: #e8e8f0;
                vertical-alignment: center;
            }
        }

        Text {
            text: target_name + " sedang dibekukan oleh sistem.";
            font-size: 13px;
            horizontal-alignment: center;
            color: #8888aa;
        }

        Rectangle {
            height: 40px;
            background: #16213e;
            border-radius: 8px;
            border-color: #0f3460;
            border-width: 1px;

            input := LineEdit {
                placeholder-text: "Masukkan Password...";
                input-type: password;
                font-size: 14px;
            }
        }

        Text {
            text: root.error_msg;
            color: #ff6b6b;
            font-size: 12px;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 110px;
                height: 40px;
                border-radius: 8px;
                background: cancel-touch.has-hover ? #2a2a44 : #252540;
                border-color: #3a3a55;
                border-width: 1px;

                cancel-touch := TouchArea {
                    clicked => { root.cancel-requested(); }
                }

                Text {
                    text: "Batal";
                    font-size: 14px;
                    font-weight: 600;
                    color: #aaaacc;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 140px;
                height: 40px;
                border-radius: 8px;
                background: unlock-touch.has-hover ? #2952a3 : #3b82f6;

                unlock-touch := TouchArea {
                    clicked => { root.unlock-requested(input.text); }
                }

                Text {
                    text: "🔓 Buka Kunci";
                    font-size: 14px;
                    font-weight: 700;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}