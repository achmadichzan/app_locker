import { CheckBox, ScrollView, LineEdit } from "std-widgets.slint";

export struct AppItem {
    name: string,
    locked: bool,
}

export component ManagementPanel inherits Window {
    in-out property <[AppItem]> apps: [];
    in-out property <string> new-app-name: "";
    in-out property <string> status-msg: "";

    callback toggle-app(int);
    callback add-app(string);
    callback remove-app(int);
    callback save-config();

    title: "App Locker";
    width: 480px;
    height: 520px;
    background: #1a1a2e;

    VerticalLayout {
        padding: 28px;
        spacing: 12px;

        HorizontalLayout {
            alignment: center;
            spacing: 10px;

            Text {
                text: "🔒";
                font-size: 26px;
                vertical-alignment: center;
            }
            Text {
                text: "App Locker";
                font-size: 26px;
                font-weight: 800;
                color: #e8e8f0;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Pilih aplikasi yang ingin dikunci";
            font-size: 13px;
            color: #8888aa;
            horizontal-alignment: center;
        }

        Rectangle {
            background: #16213e;
            border-radius: 12px;
            border-color: #0f3460;
            border-width: 1px;
            vertical-stretch: 1;

            ScrollView {
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;

                    for item[index] in root.apps: Rectangle {
                        height: 48px;
                        background: item-ta.has-hover ? #1a2744 : transparent;
                        border-radius: 8px;

                        item-ta := TouchArea {}

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 12px;
                            spacing: 12px;

                            CheckBox {
                                checked: item.locked;
                                toggled => { root.toggle-app(index); }
                            }

                            Text {
                                text: item.name;
                                font-size: 14px;
                                color: item.locked ? #e8e8f0 : #6a6a8a;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 6px;
                                background: del-ta.has-hover ? #3d1a1a : transparent;

                                del-ta := TouchArea {
                                    clicked => { root.remove-app(index); }
                                }

                                Text {
                                    text: "✕";
                                    font-size: 14px;
                                    color: del-ta.has-hover ? #ff6b6b : #555577;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            height: 38px;

            app-input := LineEdit {
                placeholder-text: "Contoh: chrome.exe";
                text <=> root.new-app-name;
                font-size: 13px;
                horizontal-stretch: 1;
            }

            Rectangle {
                width: 90px;
                height: 38px;
                border-radius: 8px;
                background: add-ta.has-hover ? #1a6b3a : #16a34a;

                add-ta := TouchArea {
                    clicked => {
                        if root.new-app-name != "" {
                            root.add-app(root.new-app-name);
                            root.new-app-name = "";
                        }
                    }
                }

                Text {
                    text: "+ Tambah";
                    font-size: 13px;
                    font-weight: 600;
                    color: white;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 44px;
            border-radius: 10px;
            background: save-ta.has-hover ? #2952a3 : #3b82f6;

            save-ta := TouchArea {
                clicked => { root.save-config(); }
            }

            Text {
                text: "💾  Simpan Konfigurasi";
                font-size: 15px;
                font-weight: 700;
                color: white;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.status-msg;
            font-size: 12px;
            color: #16a34a;
            horizontal-alignment: center;
        }
    }
}
